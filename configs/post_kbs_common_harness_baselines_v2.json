  "size_axis_note": "512-side arms use the PLAIN historical draw (--adapt-size-per-class 512): cross-size contrasts are seed-paired only, never proposal-coupled (amendment section 2). DDM/ADWIN/replay are not duplicated at 512 (amendment section 2 rationale).",
  "statistical_families": {
    "PF1_zero_drift_loss_avoidance_2000": {"contrasts": 18, "contrast": "{atc,doc,enscal,replay,ddm,adwin} vs naive @2000", "regimes": "zero x3", "correction": "Holm FWER", "status": "primary"},
    "PF2_full_drift_benefit_retention_2000": {"contrasts": 18, "contrast": "{atc,doc,enscal,replay,ddm,adwin} vs naive @2000", "regimes": "full x3", "correction": "Holm FWER", "status": "primary"},
    "PF3_estimators_vs_point_2000": {"contrasts": 12, "contrast": "{atc,doc} vs point @2000", "regimes": "all 6", "correction": "Holm FWER", "status": "primary"},
    "SF4_512_sensitivity": {"contrasts": 18, "contrast": "{atc,doc,enscal} vs naive @512", "regimes": "all 6", "correction": "Holm FWER", "status": "secondary"},
    "SF5_method_x_size_interaction": {"contrasts": 30, "contrast": "(k - naive)@2000 - (k - naive)@512, k in {point,strict,atc,doc,enscal}", "regimes": "all 6", "correction": "Holm FWER", "status": "secondary; seed-paired only"}
  },
  "anchor_contrasts_note": "naive-never and point/strict-naive contrasts are DESCRIPTIVE in this experiment (their registered hypotheses live in the sealed size-matched control and in experiment post_kbs_size_matched_drift); this experiment must not double-test them.",
  "margins": {"ba_equivalence_primary_pp": 0.5, "ba_equivalence_sensitivities_pp": [0.2, 1.0],
              "attack_recall_noninferiority_pp": 1.0, "attack_recall_sensitivities_pp": [0.5, 2.0],
              "fpr_noninferiority_pp": 0.5, "fpr_sensitivities_pp": [0.25, 1.0]},
  "outcome_rules": "amendment section 4: per-cell MATERIAL GAIN / MATERIAL COST / COMPATIBLE / UNRESOLVED (magnitude-aware; no sign-rate criterion anywhere); statements S1-S3 at 2000/class; S4 ordering-change rule",
  "stop_rule": "one pass over seeds 5001-5030 after all 96 arms complete; no extension, no interim analysis; confirmatory analysis script committed before the run",
  "fidelity_gates": [
    "anchor flag-off byte-parity vs stored symmetric-pipeline smoke outputs (4242-4243)",
    "ATC/DoC decisions bit-agree with the v1 implementation on a shared configuration",
